# Windows / OS
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.log

# Build outputs
bin/
dist-release/
backend/*.exe
backend/*.test
backend/coverage.out
backend/out/

# Backend embed output (copied from frontend/dist by build.bat)
# 保留 .gitkeep 占位（go:embed all:dist 要求目录存在），忽略实际构建产物
backend/internal/web/dist/*
!backend/internal/web/dist/.gitkeep

# App runtime data (.memora/config.json holds API keys / meta.db)
**/.memora/

# Frontend (see frontend/.gitignore for the rest)
frontend/node_modules/

# Local tooling
.claude/settings.local.json
.meituan-catpaw/
.reasonix/

# Editor
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Agent runtime data
.zcode/
